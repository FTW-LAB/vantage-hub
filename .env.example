# Public hostname (no scheme)
VITE_PUBLIC_HOSTNAME=ftwlab.com

# Dual-forge identity (org lanes only — never personal handles on UI)
VITE_PUBLIC_GITHUB_ORG=FTW-LAB
VITE_PUBLIC_HF_ORG=FTWLAB

# Optional server-only: read-only PAT for higher public org event rate limits
# NEVER commit real tokens. Set in Vercel Project → Settings → Environment Variables.
# GITHUB_TOKEN=
